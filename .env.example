# SecurATS – Umgebungsvariablen für docker-compose
# Kopieren nach `.env` und Werte setzen:  cp .env.example .env
#
# WICHTIG: Diese Datei enthält nur Platzhalter. Die echte `.env` ist per
# .gitignore ausgeschlossen und darf NIEMALS committet werden.

# Django Secret Key – zufälligen, langen Wert erzeugen, z.B.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Fernet-Schlüssel für die PII-Verschlüsselung at-rest – erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Kommagetrennte Liste erlaubter Hosts (Domain(s) der Installation)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Ziel-Datenbank (WP7) ---
# Produktion: PostgreSQL aktivieren, indem POSTGRES_HOST gesetzt wird.
# Ohne POSTGRES_HOST läuft SQLite (nur Entwicklung/Evaluation).
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# POSTGRES_DB=securats
# POSTGRES_USER=securats
# POSTGRES_PASSWORD=change-me

# --- Feeds & Freigaben ---
# FEED_ACCESS_TOKEN=langer-zufaelliger-wert   # sichert Stepstone/BA-Feeds (WP2)
# APPROVAL_SLA_DAYS wird als SystemSetting gepflegt (Default 7)

# --- Lokale KI ---
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434
