datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// 1. ORGANIZATION DOMAIN
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities  Facility[]
  jobPostings JobPosting[]
}

model Facility {
  id          String  @id @default(uuid())
  name        String
  description String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPostings JobPosting[]
  profile     FacilityProfile?
  departments Department[]
  contacts    FacilityContactPerson[]
  users       UserFacility[]
  workflows   WorkflowDefinition[]
  appWorkflows AppWorkflowDef[]
}

model FacilityProfile {
  id          String   @id @default(uuid())
  facilityId  String   @unique
  facility    Facility @relation(fields: [facilityId], references: [id])
  description String?
  images      String   @default("[]") // Workaround für SQLite, eigentlich String[]
  slug        String?  @unique // Für /einrichtungen/[slug]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  slug        String?  @unique
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPostings JobPosting[]
  contacts    DepartmentContactPerson[]
}

model Location {
  id         String   @id @default(uuid())
  name       String
  address    String?
  city       String?
  postalCode String?
  lat        Float?   // Breitengrad (Geocoding)
  lng        Float?   // Längengrad (Geocoding)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  jobPostings JobPosting[]
}

model JobFamily {
  id          String   @id @default(uuid())
  name        String
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPostings JobPosting[]
  textSnippets TextSnippet[]
}

model CareerPath {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactPerson {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  photoUrl  String?
  quote     String?  // Motivations-Zitat
  globalJobTitle String? // z.B. "HR Manager"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilityLinks FacilityContactPerson[]
  departmentLinks DepartmentContactPerson[]
  jobPostings JobPosting[]
}

model FacilityContactPerson {
  id              String @id @default(uuid())
  facilityId      String
  contactPersonId String
  roleTitle       String? // Lokaler Titel an DIESEM Standort
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  contactPerson   ContactPerson @relation(fields: [contactPersonId], references: [id], onDelete: Cascade)
  
  @@unique([facilityId, contactPersonId])
}

model DepartmentContactPerson {
  id              String @id @default(uuid())
  departmentId    String
  contactPersonId String
  roleTitle       String?
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  contactPerson   ContactPerson @relation(fields: [contactPersonId], references: [id], onDelete: Cascade)

  @@unique([departmentId, contactPersonId])
}

// ============================================================================
// 2. GOVERNANCE & SECURITY DOMAIN
// ============================================================================

model WorkflowState {
  id          String   @id @default(uuid())
  name        String   @unique // draft, in_review, approved, published, archived, rejected
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPostings JobPosting[]
}

model PrivacyNoticeVersion {
  id        String   @id @default(uuid())
  version   String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applications Application[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @default("") 
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facilities   UserFacility[]
  approvalSteps ApprovalStep[]
  appSteps      AppStep[] @relation("AppStepUser")

  delegationsGiven    RoleDelegation[] @relation("DelegationsGiven")
  delegationsReceived RoleDelegation[] @relation("DelegationsReceived")
}

model UserFacility {
  id         String @id @default(uuid())
  userId     String
  facilityId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
}

// ============================================================================
// 3. JOB DOMAIN & MODULARITY
// ============================================================================

model JobTemplate {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPostings JobPosting[]
}

model Benefit {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String?  // z.B. Emoji oder Icon-Klasse
  description String?
  
  jobPostings JobPosting[] // Implicit many-to-many
}

model TextSnippet {
  id          String   @id @default(uuid())
  category    String   // z.B. "TASKS", "REQUIREMENTS", "INTRO"
  content     String
  jobFamilyId String?
  jobFamily   JobFamily? @relation(fields: [jobFamilyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model JobPosting {
  id          String  @id @default(uuid())
  title       String
  
  // Legacy monolithic text (we keep it for backwards compatibility during migration)
  description String?
  
  // Modular approach
  tasksJson              String @default("[]") // Liste der Aufgaben (als JSON-String)
  requirementsJson       String @default("[]") // Liste der Anforderungen (als JSON-String)
  screeningQuestionsJson String @default("[]") // Dynamische K.O.-Fragen
  
  contactPersonId String?
  contactPerson   ContactPerson? @relation(fields: [contactPersonId], references: [id], onDelete: SetNull)

  // Mandatory N:1 Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  jobFamilyId String
  jobFamily   JobFamily @relation(fields: [jobFamilyId], references: [id])

  workflowStateId String
  workflowState   WorkflowState @relation(fields: [workflowStateId], references: [id])

  jobTemplateId String?
  jobTemplate   JobTemplate? @relation(fields: [jobTemplateId], references: [id])

  benefits Benefit[] // Implicit many-to-many

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvalTicket ApprovalTicket?
  applications   Application[]
  interviewSlots InterviewSlot[]
}

// ============================================================================
// NEW: WORKFLOW & APPROVAL ENGINE
// ============================================================================

model WorkflowDefinition {
  id          String   @id @default(uuid())
  name        String
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  // Definiert die Schritte als JSON Array, z.B. [{ order: 1, roleId: "..." }, { order: 2, roleId: "..." }]
  stepsJson   String   @default("[]")
  createdAt   DateTime @default(now())
}

model ApprovalTicket {
  id           String   @id @default(uuid())
  jobPostingId String   @unique
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  steps        ApprovalStep[]
}

model ApprovalStep {
  id               String   @id @default(uuid())
  approvalTicketId String
  approvalTicket   ApprovalTicket @relation(fields: [approvalTicketId], references: [id], onDelete: Cascade)
  
  stepOrder        Int
  assignedRoleId   String?  // Optional: zugewiesen an eine Rolle
  assignedUserId   String?  // Optional: zugewiesen an einen spezifischen User

  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  comments         String?
  actionTakenAt    DateTime?

  actionTakenById  String?
  actionTakenBy    User?    @relation(fields: [actionTakenById], references: [id], onDelete: SetNull)
}

// ============================================================================
// 4. APPLICATION DOMAIN (ATS & Workflow)
// ============================================================================

model Applicant {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  // PII At-Rest Encryption or isolation implies these fields should be treated carefully in backend
  
  tokens    ApplicantToken[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicantToken {
  id          String   @id @default(uuid())
  token       String   @unique
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model Application {
  id             String   @id @default(uuid())
  applicantId    String
  applicant      Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  
  jobPostingId   String
  jobPosting     JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  
  cvStorageId    String? // z.B. MinIO Object Key (encrypted)
  coverLetterTxt String?
  screeningAnswersJson String @default("{}")

  // AI Screening Results
  aiScore        String?  // "A", "B", "C", "D"
  aiRationale    String?
  
  status         String   @default("NEW") // NEW, IN_REVIEW, MISSING_DOCS, INVITED, REJECTED, WITHDRAWN
  withdrawReason String?
  
  privacyNoticeVersionId String?
  privacyNoticeVersion   PrivacyNoticeVersion? @relation(fields: [privacyNoticeVersionId], references: [id])

  consentTalentPool Boolean @default(false) // DSGVO: Opt-In für längere Speicherung
  internalNotes  String   @default("")

  appTicket      AppTicket?
  interviewSlot  InterviewSlot?
  interviews     Interview[]
  messages       Message[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Application Workflow Engine
model AppWorkflowDef {
  id          String   @id @default(uuid())
  name        String
  facilityId  String?
  facility    Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  locationIdsJson String @default("[]") // Workaround für SQLite (Array von Location-IDs)
  stepsJson   String   @default("[]") // Definition der Schritte
  createdAt   DateTime @default(now())
  
  appTickets  AppTicket[]
}

model AppTicket {
  id            String   @id @default(uuid())
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workflowId    String
  workflow      AppWorkflowDef @relation(fields: [workflowId], references: [id])
  status        String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  steps         AppStep[]
}

model AppStep {
  id             String   @id @default(uuid())
  appTicketId    String
  appTicket      AppTicket @relation(fields: [appTicketId], references: [id], onDelete: Cascade)
  
  stepOrder      Int
  assignedUserId String?
  assignedUser   User?    @relation("AppStepUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED, RETURNED
  comments       String?
  actionTakenAt  DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Interview {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  locationType  String      // z.B. "REMOTE", "IN_PERSON"
  meetingLink   String?
  outcome       String?     // z.B. "PASSED", "FAILED"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model InterviewSlot {
  id            String      @id @default(uuid())
  jobPostingId  String
  jobPosting    JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  startTime     DateTime
  endTime       DateTime
  isBooked      Boolean     @default(false)
  
  applicationId String?     @unique
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime    @default(now())
}

model Message {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  direction     String      // "INBOUND", "OUTBOUND"
  content       String
  readStatus    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model TalentPoolSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  criteria  String   @default("{}") // Workaround für SQLite, eigentlich Json
  consentId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// CMS PAGE MANAGEMENT
// ============================================================================

model Page {
  id         String   @id @default(uuid())
  title      String
  slug       String   @unique          // URL-Pfad z.B. "ueber-uns"
  content    String   @default("")     // Markdown-Inhalt
  status     String   @default("published") // published | draft | archived
  navEnabled Boolean  @default(true)   // Sichtbar in Navigation?
  navLabel   String?                   // Anzeigename in Nav (wenn abweichend)
  navParent  String?                   // Slug des Eltern-Eintrags (für Untermenüs)
  navOrder   Int      @default(0)      // Reihenfolge in der Navigation
  metaDesc   String?                   // SEO Meta-Description
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// 6. JOB ALERTS SUBSYSTEM
// ============================================================================

model JobAlertSubscription {
  id                String   @id @default(uuid())
  email             String   @unique 
  status            String   @default("PENDING") // PENDING, ACTIVE, INACTIVE

  globalAlert       Boolean  @default(false)
  categories        String   @default("[]") 
  locations         String   @default("[]") 
  radiusKm          Int?     

  confirmationToken String?  @unique
  managementToken   String?  @unique

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastConfirmedAt   DateTime @default(now())
  lastAlertSentAt   DateTime?

  logs              JobAlertLog[]
}

model JobAlertLog {
  id               String   @id @default(uuid())
  subscriptionId   String
  subscription     JobAlertSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action           String   
  metadata         String   @default("{}") 
  createdAt        DateTime @default(now())
}

// ============================================================================
// 7. SYSTEM SETTINGS & TEMPLATES
// ============================================================================

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique 
  value     String   
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String   @unique 
  subject     String
  htmlContent String   
  textContent String?  
  updatedAt   DateTime @updatedAt
}

model ScreeningQuestion {
  id        String   @id @default(uuid())
  question  String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================================
// 8. IAM & DELEGATION OF AUTHORITY (URLaubsvertretung)
// ============================================================================

model RoleDelegation {
  id          String   @id @default(uuid())
  
  delegatorId String
  delegator   User     @relation("DelegationsGiven", fields: [delegatorId], references: [id], onDelete: Cascade)
  
  delegateeId String
  delegatee   User     @relation("DelegationsReceived", fields: [delegateeId], references: [id], onDelete: Cascade)
  
  scopeType   String   // z.B. "ALL", "FACILITY", "JOB"
  scopeId     String?  // Die ID des Standorts oder Jobs (falls spezifiziert)
  
  validFrom   DateTime
  validUntil  DateTime
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Es darf immer nur EINE aktive Delegation von A nach B für denselben Scope geben
  @@unique([delegatorId, delegateeId, scopeType, scopeId])
}

// ============================================================================
// 9. AUDIT & COMPLIANCE (DSGVO / ISO 27001)
// ============================================================================

model AuditLog {
  id            String   @id @default(uuid())
  action        String   // z.B. "READ_CV", "STATUS_CHANGE", "DELETE_APPLICANT"
  userId        String?  // Der aufrufende User (falls vorhanden)
  applicationId String?  // Die betroffene Bewerbung
  metadataJson  String   @default("{}") // Weitere Details
  createdAt     DateTime @default(now())
}
