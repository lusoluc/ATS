FROM node:20-alpine AS builder

WORKDIR /app

# Install OpenSSL and glibc compatibility library for Prisma
RUN apk add --no-cache openssl libc6-compat

# Install dependencies first (for better caching)
COPY package*.json ./
RUN npm install --legacy-peer-deps

# Copy config and source files
COPY tsconfig.json ./
COPY src ./src
COPY frontend/prisma ./frontend/prisma

# Generate Prisma Client
RUN npx prisma generate --schema=frontend/prisma/schema.prisma

# Build the TypeScript files
RUN npx tsc

# Production stage
FROM node:20-alpine

WORKDIR /app

# Install OpenSSL and glibc compatibility library for Prisma
RUN apk add --no-cache openssl libc6-compat

# Copy package info
COPY package*.json ./

# Copy built JS files and complete node_modules from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules


# Environment variables will be loaded from compose or shell
EXPOSE 3001

CMD ["node", "dist/index.js"]
