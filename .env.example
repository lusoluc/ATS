# SecurATS – Umgebungsvariablen für docker-compose
# Kopieren nach `.env` und Werte setzen:  cp .env.example .env
#
# WICHTIG: Diese Datei enthält nur Platzhalter. Die echte `.env` ist per
# .gitignore ausgeschlossen und darf NIEMALS committet werden.

# Django Secret Key – zufälligen, langen Wert erzeugen, z.B.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Fernet-Schlüssel für die PII-Verschlüsselung at-rest – erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Kommagetrennte Liste erlaubter Hosts (Domain(s) der Installation)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Ziel-Datenbank (WP7) ---
# DATENBANK: PostgreSQL ist Pflicht (Produktion bricht ohne ab).
# Mit docker-compose ist der Host 'db' (der mitgelieferte PostgreSQL-Dienst).
# SQLite ist NUR für lokale Entwicklung (DEBUG=True) erlaubt – es sperrt bei
# parallelen Schreibzugriffen die ganze Datei und ist im Mehrbenutzerbetrieb
# untragbar.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=securats
# POSTGRES_USER=securats
# POSTGRES_PASSWORD=change-me

# --- Feeds & Freigaben ---
# FEED_ACCESS_TOKEN=langer-zufaelliger-wert   # sichert Stepstone/BA-Feeds (WP2)
# APPROVAL_SLA_DAYS wird als SystemSetting gepflegt (Default 7)

# --- Lokale KI ---
# OLLAMA_HOST darf auch "rechner:11500" enthalten; sonst gilt OLLAMA_PORT.
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434

# --- HRIS-Übergabe eingestellter Personen (manage.py hris_export) ---
# Ohne HRIS_ENDPOINT wird NICHTS übertragen – der Befehl bricht ab und sagt
# das auch. Die Feldzuordnung wird in der Oberfläche gepflegt (SAP-Mapper).
# HRIS_ENDPOINT=https://hris.example/api/candidates
# HRIS_TOKEN=bearer-token-des-zielsystems

# --- E-Mail-Versand ---
# Ohne Konfiguration wird NICHTS zugestellt – die Anwendung sagt das offen
# (Einstellungen -> E-Mail-Versand). Alternativ pflegen HR-Admins den
# Mailserver dort in der Oberfläche; hier gesetzte Werte haben Vorrang und
# sind im Formular gesperrt.
# EMAIL_HOST=mail.traeger.de
# EMAIL_PORT=587
# EMAIL_SECURITY=starttls        # starttls | ssl | none
# EMAIL_HOST_USER=ats-versand
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=bewerbung@traeger.de
